.hero{background-image:url('/images/The-Jordan-Restaurant-with-Marthinus-Ferreira-1536x858.jpg')}
:root{--cream:#faf9f4;--white:#fff;--charcoal:#1a1c1a;--muted:#5f625d;--line:#c9cbc4;--gold:#d4af37;--soft:#efeee9;--serif:'Playfair Display',Georgia,serif;--sans:'Inter',Arial,sans-serif;--max:1240px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--charcoal);font-family:var(--sans);line-height:1.6}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}.site-header{height:74px;display:flex;align-items:center;gap:28px;padding:0 5vw;border-bottom:1px solid var(--line);background:rgba(250,249,244,.96);position:sticky;top:0;z-index:20}.brand{font-family:var(--serif);font-size:24px;font-weight:700;white-space:nowrap}.brand span{font-style:italic;font-weight:500}.nav{display:flex;gap:28px;margin-left:auto}.nav a{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}.nav a:hover{color:var(--gold)}.nav-cta{border:1px solid var(--gold);padding:10px 16px;font-size:12px;text-transform:uppercase;letter-spacing:.1em}.menu-toggle{display:none;border:0;background:none;font-size:24px}.hero{min-height:calc(100vh - 74px);display:grid;place-items:center;position:relative;background:linear-gradient(90deg,rgba(0,0,0,.7),rgba(0,0,0,.2)),url('https://images.unsplash.com/photo-1544148103-0773bf10d330?auto=format&fit=crop&w=1800&q=85') center/cover}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,12,10,.65),rgba(12,12,10,.08))}.hero-content{position:relative;color:white;max-width:1240px;width:100%;padding:90px 5vw}.eyebrow{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:var(--muted);margin:0 0 14px}.hero .eyebrow,.gold-text{color:var(--gold)}h1,h2,h3{font-family:var(--serif);line-height:1.08;margin:0}h1{font-size:clamp(52px,7vw,96px);max-width:850px}h1 em,h2 em{font-weight:500}h2{font-size:clamp(36px,5vw,64px)}h3{font-size:28px}.hero-content>p:not(.eyebrow){font-size:19px;max-width:620px;color:#eee;margin:28px 0}.actions{display:flex;gap:14px;flex-wrap:wrap}.btn{display:inline-flex;justify-content:center;align-items:center;min-height:48px;padding:0 22px;border:1px solid transparent;text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:700}.btn.gold{background:var(--gold);color:var(--charcoal);border-color:var(--gold)}.btn.ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.75)}.btn.dark{background:var(--charcoal);color:#fff}.btn.full{width:100%}.dashboard-actions{display:flex;align-items:center;gap:12px}.dashboard-actions .btn{min-width:120px}.dashboard-actions .btn.ghost{background:#fff;color:var(--charcoal);border-color:var(--line)}.dashboard-actions .btn.dark{background:var(--charcoal);color:#fff}.section{max-width:var(--max);margin:auto;padding:100px 5vw}.intro{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end}.lead{font-size:18px;color:var(--muted);max-width:650px}.section-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:45px}.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{background:none;border:1px solid var(--line);padding:9px 14px;text-transform:uppercase;font-size:10px;letter-spacing:.12em}.filter.active{background:var(--charcoal);color:#fff;border-color:var(--charcoal)}.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.menu-card{background:#fff;border:1px solid var(--line)}.menu-card img{width:100%;height:230px;object-fit:cover;display:block}.menu-info{padding:22px}.menu-top{display:flex;justify-content:space-between;gap:15px}.menu-card h3{font-size:23px}.price{font-weight:700;color:#9b7a0c;white-space:nowrap}.category{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:var(--muted)}.menu-card p{color:var(--muted);font-size:14px}.dark-section{max-width:none;background:var(--charcoal);color:#fff}.split{max-width:var(--max);margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.split>div>p:not(.eyebrow){color:var(--muted);max-width:520px}.dark-section .split>div>p:not(.eyebrow){color:#c9cbc4}.details{display:flex;gap:20px;flex-wrap:wrap;color:var(--gold);font-size:12px;text-transform:uppercase;letter-spacing:.08em;margin-top:30px}.form-card{background:#fff;color:var(--charcoal);padding:38px;border:1px solid #4a4b47}.form-card.light{border-color:var(--line)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.form-card label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--muted);margin-bottom:18px}.form-card input,.form-card select,.form-card textarea{width:100%;display:block;margin-top:8px;border:0;border-bottom:1px solid var(--line);background:transparent;padding:10px 0;outline:none;color:var(--charcoal)}.form-card input:focus,.form-card select:focus,.form-card textarea:focus{border-color:var(--gold)}.form-message{font-size:13px;min-height:20px;color:#657b50}.feedback-section{background:#e9e8e3;max-width:none;padding:100px 5vw}.links-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.card{background:#fff;border:1px solid var(--line);padding:32px}.card h3{font-size:20px;margin-bottom:12px}.card p{color:var(--muted);font-size:15px;margin:0}.reverse{max-width:var(--max);margin:0 auto}.quote{padding-right:30px}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.contact-list{display:grid;grid-template-columns:1fr 1fr;gap:35px}.contact-list strong{font-size:10px;letter-spacing:.16em}.contact-list p{color:var(--muted)}.dashboard-section{background:#fff;max-width:none}.stats{max-width:var(--max);margin:0 auto 35px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stat{border:1px solid var(--line);padding:24px}.stat span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.stat strong{font-family:var(--serif);font-size:42px}.table-wrap{max-width:var(--max);margin:auto;overflow:auto}.table-wrap table{width:100%;border-collapse:collapse;min-width:650px}.table-wrap th,.table-wrap td{text-align:left;padding:15px;border-bottom:1px solid var(--line);font-size:13px}.table-wrap th{text-transform:uppercase;letter-spacing:.1em;font-size:10px}.loading{text-align:center;color:var(--muted);padding:50px}footer{background:var(--charcoal);color:#fff;padding:50px 5vw;display:flex;justify-content:space-between;gap:30px;align-items:center;flex-wrap:wrap}footer p{color:#aaa;font-size:13px}.toast{position:fixed;right:22px;bottom:22px;background:var(--charcoal);color:#fff;padding:14px 18px;border-left:3px solid var(--gold);transform:translateY(120px);transition:.3s;z-index:50}.toast.show{transform:none}@media(max-width:900px){.nav{display:none;position:absolute;top:74px;left:0;right:0;background:var(--cream);border-bottom:1px solid var(--line);padding:20px 5vw;flex-direction:column;gap:18px}.nav.open{display:flex}.menu-toggle{display:block;margin-left:auto}.nav-cta{display:none}.intro,.split,.contact-grid{grid-template-columns:1fr;gap:45px}.menu-grid{grid-template-columns:repeat(2,1fr)}.links-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.section{padding:75px 5vw}.hero-content{padding:70px 5vw}}@media(max-width:600px){.site-header{padding:0 16px}.menu-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.contact-list{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.hero{min-height:680px}h1{font-size:50px}.section-heading{display:block}.filters{margin-top:22px}.form-card{padding:24px}.stats .stat{padding:18px}.stat strong{font-size:34px}footer{display:block}.hero-content>p:not(.eyebrow){font-size:16px}}
