{
  "buildCommand": "npm install",
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*).html", "dest": "/api/index.js" },
    { "src": "/", "dest": "/api/index.js" }
  ]
}
